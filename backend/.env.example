# Application
APP_NAME=my-web-backend
DEBUG=false

# Database (MySQL)
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/my_web
REDIS_URL=redis://127.0.0.1:6379/0

# Auth / JWT
JWT_SECRET_KEY=please-change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (JSON array)
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Never use '*' together with credentials in production.
TRUSTED_HOSTS=["127.0.0.1","localhost"]

# Optional health dependency and operational controls
LOG_LEVEL=INFO
RATE_LIMIT_GENERAL=120
RATE_LIMIT_AUTH=10
RATE_LIMIT_CHAT=30
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# LLM (OpenAI-compatible provider)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=30
LLM_FAST_MODEL=
LLM_STANDARD_MODEL=
LLM_REASONING_MODEL=
# openai_compatible (default) | mock (offline canned responses; E2E/capacity only)
LLM_PROVIDER_LABEL=openai_compatible
AGENT_MAX_STEPS=6
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT=30

# Vision (image understanding). Choose one source:
#  A) OpenAI-compatible vision endpoint (e.g. siliconflow):
VISION_MODEL=
VISION_MODEL_TIER=standard
VISION_API_KEY=
VISION_BASE_URL=
#  B) Taotoken:
TAOTOKEN_API_KEY=
TAOTOKEN_BASE_URL=
TAOTOKEN_VISION_MODEL=
# Minimum per-request charge when the provider reports no usable image tokens.
VISION_BASE_CREDIT_COST=0
RAG_UPLOAD_DIR=./data/uploads
RAG_MAX_UPLOAD_BYTES=10485760
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_MAX_CONTEXT_CHARS=12000
WORKFLOW_MAX_STEP_ATTEMPTS=3
DOCUMENT_TASK_QUEUE=document-processing
DOCUMENT_TASK_MAX_RETRIES=5
DOCUMENT_TASK_RETRY_BASE_SECONDS=60
DOCUMENT_TASK_RETRY_MAX_SECONDS=3600
DOCUMENT_TASK_LEASE_SECONDS=300
DOCUMENT_TASK_DISPATCH_INTERVAL_SECONDS=5
CREDIT_GRANT_ON_REGISTER=1000
CREDIT_INPUT_RATE=1
CREDIT_OUTPUT_RATE=2
# Classroom Beta registration gate. Production MUST be true (requires a valid
# invite code); false opens registration and re-enables the credit-farming P0.
INVITE_REQUIRED=true
BETA_REGISTER_CREDITS=2000
# Referral rewards are disabled (0) for beta: self-referral farming cannot be
# reliably detected without IP/device identity tracking.
REFERRAL_REWARD_CREDITS=0
REFERRAL_NEW_USER_CREDITS=0
