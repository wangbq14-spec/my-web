# Application
APP_NAME=my-web-backend
DEBUG=false

# Database (MySQL)
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/my_web

# Auth / JWT
JWT_SECRET_KEY=please-change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (JSON array)
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
